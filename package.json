{
  "name": "ai-pr-review-bot",
  "version": "1.0.0",
  "description": "AI-powered GitHub Pull Request Review Bot using Node.js, Fastify, Octokit, and Gemini API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:tunnel": "tsx scripts/dev-tunnel.ts",
    "test": "vitest run",
    "test:smoke": "tsx scripts/smoke-test-models.ts",
    "action:review": "tsx src/action-runner.ts"
  },
  "keywords": [
    "github-app",
    "pull-request-review",
    "gemini",
    "fastify",
    "octokit",
    "zod"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "parse-diff": "^0.14.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.3.3",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "smee-client": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}