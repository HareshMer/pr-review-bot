# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# GitHub App Authentication
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Gemini LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_RETRY_MAX_DELAY_MS=10000

# Review Configuration
REVIEW_EVENT_VERDICT=COMMENT
MAX_DIFF_LINES_PER_PR=15000
MAX_FILE_SIZE_BYTES=512000

# Optional Smee.io Webhook Tunnel (for local development)
SMEE_URL=https://smee.io/your_unique_smee_channel

